#!/bin/zsh -f
# 假的 Sparkle generate_keys（测试 scripts/release.sh 的发布前检查用，不碰钥匙串）。
#
# 每次调用把参数逐行追加到 $FAKE_GENERATE_KEYS_LOG（每个参数一行 arg=<参数>，调用之间空一行）。
# 可选环境变量：
#   FAKE_GENERATE_KEYS_PUBLIC  `-p` 时输出的公钥；未设置时模拟"钥匙串里没有这把私钥"（退出码 1）

emulate -R zsh

if [[ -n ${FAKE_GENERATE_KEYS_LOG-} ]]; then
  { for a in "$@"; do print -r -- "arg=$a"; done; print } >> $FAKE_GENERATE_KEYS_LOG
fi

if [[ -z ${FAKE_GENERATE_KEYS_PUBLIC-} ]]; then
  print -u2 -r -- "ERROR! There is no existing EdDSA private key in your keychain."
  exit 1
fi
print -r -- $FAKE_GENERATE_KEYS_PUBLIC
